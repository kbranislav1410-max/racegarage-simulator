# === PRODUKČNÁ KONFIGURÁCIA - .env.production ===
# Skopírujte tento súbor do .env a vyplňte vaše hodnoty

# === DATABÁZA (POVINNÉ) ===
# PostgreSQL Connection String
# Formát: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Príklady:
#   - Neon.tech: postgresql://user:pass@ep-xyz.eu-central-1.aws.neon.tech/racegarage
#   - Supabase: postgresql://user:pass@db.xyz.supabase.co:5432/postgres
#   - VPS: postgresql://user:pass@localhost:5432/racegarage
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# === EMAIL (VOLITEĽNÉ) ===
# Ak nechcete posielať emaily, nechajte EMAIL_PROVIDER prázdne
# Aplikácia bude fungovať aj bez emailov

# Provider: "resend", "nodemailer", alebo prázdne
EMAIL_PROVIDER=""

# Email odosielateľa (použije sa pri všetkých emailoch)
EMAIL_FROM="noreply@vasadomena.sk"

# === RESEND (Jednoduchý, Odporúčaný) ===
# Zaregistrujte sa na: https://resend.com
# Získajte API kľúč v dashboard
# Zadarmo: 100 emailov/deň
RESEND_API_KEY=""

# === NODEMAILER / SMTP (Websupport Email) ===
# Použite ak máte email na websupport.sk
EMAIL_PROVIDER="nodemailer"
SMTP_HOST="smtp.websupport.sk"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="vasemail@vasadomena.sk"
SMTP_PASS="vaše-heslo"

# === POZNÁMKY ===
# - Všetky riadky s # sú komentáre a ignorujú sa
# - Nikdy necommitujte tento súbor s reálnymi heslami do Git
# - .env súbor je v .gitignore (automaticky ignorovaný)
# - Pre Vercel: nastavte tieto hodnoty v Settings → Environment Variables
# - Pre VPS: skopírujte tento súbor do .env v root priečinku projektu

# === KONTROLA ===
# Overte že máte vyplnené:
# ✅ DATABASE_URL
# ⚠️ EMAIL_* (voliteľné, ale odporúčané)

# === BEZPEČNOSŤ ===
# Silné heslá pre databázu:
# - Min. 16 znakov
# - Kombinácia písmen, čísiel, špeciálnych znakov
# - Generátor hesiel: https://passwordsgenerator.net

# === TESTOVANIE LOKÁLNE ===
# Pred nasadením otestujte lokálne:
# 1. Skopírujte tento súbor do .env
# 2. Vyplňte produkčné údaje
# 3. Spustite: npm run build
# 4. Spustite: npm start
# 5. Otvorte: http://localhost:3000
